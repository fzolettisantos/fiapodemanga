# URL pública do site (sem barra final). Usada em canonical, sitemap, Open Graph e JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br

# E-mail público de contato exibido no site (opcional). Deixe vazio para não exibir.
NEXT_PUBLIC_CONTACT_EMAIL=
# WhatsApp do botão "Chamar no WhatsApp": DDI + DDD + número, só dígitos (ex.: 5513999999999).
# Vazio = o botão não aparece.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Envio do formulário de contato (Resend: https://resend.com) ---
# Sem estas variáveis o formulário responde que o envio não está configurado.
RESEND_API_KEY=
# Destinatário que receberá as mensagens do formulário.
CONTACT_TO_EMAIL=
# Remetente verificado no Resend, ex.: "Fiapo de Manga <site@seudominio.com.br>"
CONTACT_FROM_EMAIL=

# ------------------------------------------------------------------
# Área admin (/admin) — ver docs/admin.md
# Sem estas variáveis, o admin roda em MODO DEMONSTRAÇÃO (dados fictícios, nada salvo).
# ------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL e NEXT_PUBLIC_SUPABASE_ANON_KEY: Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service_role: SOMENTE no servidor (nunca com prefixo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
# E-mails com acesso ao admin, separados por vírgula
ADMIN_EMAILS=

# ------------------------------------------------------------------
# SEO — ver docs/seo.md
# ------------------------------------------------------------------
# Códigos de verificação do Google Search Console e do Bing Webmaster (opcional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
