# URL pública do site (sem barra final). Usada em canonical, sitemap, Open Graph e JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br

# E-mail público de contato exibido no site (opcional). Deixe vazio para não exibir.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Envio do formulário de contato (Resend: https://resend.com) ---
# Sem estas variáveis o formulário responde que o envio não está configurado.
RESEND_API_KEY=
# Destinatário que receberá as mensagens do formulário.
CONTACT_TO_EMAIL=
# Remetente verificado no Resend, ex.: "Fiapo de Manga <site@seudominio.com.br>"
CONTACT_FROM_EMAIL=

# ------------------------------------------------------------------
# Papo Reto Ranking (/papo-reto) — ver docs/papo-reto.md
# Sem as variáveis do Supabase, /papo-reto roda em MODO DEMONSTRAÇÃO
# (participantes provisórios e números simulados, claramente sinalizados).
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública "anon": só para o Realtime do placar (leitura protegida por RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service_role": SOMENTE no servidor. Nunca use o prefixo NEXT_PUBLIC_ nela.
SUPABASE_SERVICE_ROLE_KEY=
# Assina o cookie do votante e gera os hashes de IP (mín. 32 caracteres: openssl rand -base64 48).
VOTE_SECRET=
# Máximo de votos por IP, por ranking e por período.
VOTE_IP_LIMIT_PER_PERIOD=20
# Painel /papo-reto/admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@canaldobenja
NEXT_PUBLIC_CARICATURE_CREDIT=Caricaturas: Oberdan
