# URL pública do site (sem barra final). Usada em canonical, sitemap, Open Graph e JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br

# E-mail público de contato exibido no site (opcional). Deixe vazio para não exibir.
NEXT_PUBLIC_CONTACT_EMAIL=
# WhatsApp do botão "Chamar no WhatsApp": DDI + DDD + número, só dígitos (ex.: 5513999999999).
# Vazio = o botão não aparece.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Envio do formulário de contato (Resend: https://resend.com) ---
# Sem estas variáveis o formulário responde que o envio não está configurado.
RESEND_API_KEY=
# Destinatário que receberá as mensagens do formulário.
CONTACT_TO_EMAIL=
# Remetente verificado no Resend, ex.: "Fiapo de Manga <site@seudominio.com.br>"
CONTACT_FROM_EMAIL=
